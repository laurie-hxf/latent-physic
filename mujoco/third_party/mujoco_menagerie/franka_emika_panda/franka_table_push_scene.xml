<mujoco model="franka_floor_push">
  <include file="mjx_panda.xml"/>

  <statistic center="0.35 0.0 0.2" extent="1.2"/>

  <option timestep="0.002" iterations="20" ls_iterations="16" integrator="implicitfast">
    <flag eulerdamp="disable"/>
  </option>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="960" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="floor_checker" builtin="checker" mark="edge"
      rgb1="0.20 0.26 0.32" rgb2="0.10 0.14 0.18" markrgb="0.85 0.85 0.85"
      width="300" height="300"/>
    <material name="floor_checker_mat" texture="floor_checker" texuniform="true" texrepeat="6 6" reflectance="0.0"/>
    <material name="block_mat" rgba="0.82 0.24 0.18 1"/>
    <material name="target_mat" rgba="0.18 0.72 0.30 0.25"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 0" size="0 0 0.05" type="plane" material="floor_checker_mat"
      friction="1.0 0.08 0.02" contype="1" conaffinity="1"/>

    <body name="push_block" pos="0.58 0.0 0.025">
      <freejoint/>
      <geom name="push_block_geom" type="box" size="0.025 0.025 0.025" condim="3"
        friction="1 0.03 0.003" material="block_mat" contype="2" conaffinity="3" solref="0.01 1"/>
    </body>

    <body name="push_target" mocap="true" pos="0.72 0.0 0.025">
      <geom type="box" size="0.03 0.03 0.002" material="target_mat" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="home"
      qpos="0 0.3 0 -1.57079 0 2.0 -0.7853 0.04 0.04 0.58 0 0.025 1 0 0 0"
      ctrl="0 0.3 0 -1.57079 0 2.0 -0.7853 0.04"/>
  </keyframe>
</mujoco>
